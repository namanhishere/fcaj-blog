@startuml raftdb-efs-devloop

skinparam backgroundColor #FAFAFA
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #232F3E
    FontColor #232F3E
    BorderThickness 2
    DiamondBackgroundColor #FFFFFF
    DiamondBorderColor #232F3E
    DiamondFontColor #232F3E
    StartColor #FF9900
    EndColor #232F3E
    BarColor #545B64
}

skinparam partition {
    BackgroundColor #F4F4F4
    BorderColor #545B64
    FontColor #232F3E
    FontStyle bold
}

skinparam note {
    BackgroundColor #FFE8B3
    BorderColor #545B64
    FontColor #232F3E
}

skinparam arrow {
    Color #545B64
    Thickness 1.5
}

title \n<b><size:20>RaftDB development and deploy loop on EFS</size></b>\n<size:12>the durable WAL is what survives a task replacement | one writer, never two</size>\n

start

partition "1. Local development loop (docker compose)" {
  :Edit the C++23 source, then\n""docker compose up --build -d"";
  :The raftdb service mounts the named volume\n""raftdb_data:/data/raftdb""\nRAFTDB_PORT=9100, RAFTDB_DATA_DIR=/data/raftdb;
  :Exercise the canvas locally over TCP 9100;
  note right
    The named volume ""raftdb_data"" outlives
    ""docker compose down"", so the local WAL and
    snapshot catalog are still there after a rebuild.
    That is the same durability contract EFS provides
    in production - the dev loop is not a different design.
  end note
}

partition "2. Publish an immutable image" {
  :GitLab CI builds, contract-tests and scans the image,\nthen pushes the immutable tag raftdb-COMMIT_SHA to ECR;
  :The verified digest is handed to ""cdk deploy"",\nso the RaftDb container is pinned by digest;
}

if (Where does /data/raftdb live?) then ([DEPLOYED] EFS access point\n/raftdb/production/member-1)

  partition "3. Deploy loop that keeps the canvas" {
    :""ecs update-service --force-new-deployment"";
    :minHealthyPercent: 0 / maxHealthyPercent: 100,\nso ECS STOPS the running task BEFORE it starts\nthe replacement task;
    note right
      A single RaftDB writer owns the EFS WAL.
      Two overlapping tasks would open the same
      durable files at once, so the deployment
      window is deliberately a gap, not an overlap.
      There is no task-count autoscaling.
    end note
    :SIGTERM reaches the RaftDb container;
    :stopTimeout: 120 s - graceful shutdown stops accepting\nclients, publishes a final checkpoint and flushes the WAL;
    :Old task exits; the EFS access point has no writer;
    :Replacement task mounts the SAME access point\n/raftdb/production/member-1 at /data/raftdb\n(transit encryption + IAM authorization, uid/gid 10001);

    if (Selected snapshot and WAL tail valid?) then (yes)
      :Validate and restore the local snapshot from\n/data/raftdb/snapshots, then replay the WAL tail\nfrom /data/raftdb/wal - recovery, not reseeding;
      :Publish /tmp/raftdb-ready, then bind client port 9100;
      :App container waits for RaftDb HEALTHY, then talks to\n127.0.0.1:9100 with DATA_MODE=raftdb-only;
      :Canvas, config, bans, milestones and placement history\nare exactly what they were before the deploy;
    else (no)
      :Startup FAILS instead of seeding an empty database\n(missing, corrupt, incompatible or mismatched data);
      :Health command keeps failing because\n/tmp/raftdb-ready is absent; ECS circuit breaker\nrolls the deployment back;
      stop
    endif
  }

else ([REJECTED] ephemeral task storage)

  partition "3b. Contrast: what an ephemeral volume would do" {
    :Task replacement discards the container filesystem;
    :Replacement task boots with an EMPTY /data/raftdb -\nno WAL segments, no snapshot catalog;
    :Nothing to replay and nothing to restore;
    :The canvas is lost on EVERY deploy,\nand every restart is a fresh empty board;
    note right
      This is why the WAL lives on EFS rather than
      on the task's own storage. The choice is not
      about capacity - it is the only reason a deploy
      is a rolling replacement and not a data wipe.
    end note
    stop
  }

endif

:Post-deploy: periodic checkpoints keep publishing to the\nS3 snapshot bucket under prefix production/member-1\n(RAFTDB_SNAPSHOT_INTERVAL_SECONDS=300);

stop

@enduml
